    function viewer_alloggi_1(data) {
      return (!('checkOutDone' in data) || publicScalar(data.checkOutDone))
        && (!('checkOutTime' in data) || publicScalar(data.checkOutTime))
        && (!('completed' in data) || publicScalar(data.completed))
        && (!('coordinate' in data) || publicCoordinates(data.coordinate))
        && (!('createdAt' in data) || publicScalar(data.createdAt))
        && (!('data' in data) || publicScalar(data.data))
        && (!('date' in data) || publicScalar(data.date))
