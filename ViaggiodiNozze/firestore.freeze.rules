// =============================================================================
// HOUNIGO RELEASE 1.6.0 — TEMPORARY FREEZE RULES (BONIFICA TRANSITION WINDOW)
// =============================================================================
// Derived strictly from ViaggiodiNozze/firestore.rules.
// - SAFE READS remain active across all 19 trips (Viewers see ONLY v2/safe data).
// - ALL CLIENT WRITES (create, update, delete) are BLOCKED server-side (if false)
//   across ALL 19 trips, private vaults, LIVE feeds, and user profiles so neither
//   open 1.5.16 clients nor returning offline clients can race with transactional bonifica.
// - Transactional bonifica executes server-side via Admin SDK / Google Cloud REST API.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se l'utente autenticato è l'owner del viaggio
    function isTripOwner(tripId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/trips/$(tripId)) && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
        ||
        (existsAfter(/databases/$(database)/documents/trips/$(tripId)) && (
          getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') == 'owner')
      );
    }

    // Verifica se l'utente autenticato è membro effettivo (owner o member) del viaggio
    function isTripMember(tripId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)) && (
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('members', [])
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
      );
    }

    // Verifica se l'utente autenticato ha privilegi di Amministratore Globale
    function isGlobalAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
        || request.auth.token.get('admin', false) == true
      );
    }

    // Verifica se l'utente e membro privilegiato (owner o copilota)
    function isTripPrivilegedMember(tripId) {
      return isSignedIn() && (
        isTripOwner(tripId)
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
         && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') in ['owner', 'copilota'])
        ||
        (request.resource != null && existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
         && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') in ['owner', 'copilota'])
      );
    }

    // Schema guard: blocca qualsiasi scrittura contenente chiavi sensibili
    function hasNoSensitiveKeys(data) {
      return !data.keys().hasAny([
        'pinCode', 'pin', 'codiceAccesso', 'keyboxCode', 'keybox',
        'bookingCode', 'pnr', 'codicePrenotazione', 'conferma', 'bookingReference',
        'ticketNumber', 'ticketUrl', 'voucherUrl', 'bookingUrl', 'linkPrenotazione',
        'qrCode', 'qr', 'tavolo', 'posti', 'postiASedere',
        'seat', 'terminalGate', 'gate', 'cost', 'costo',
        'budget', 'budgetConfig', 'deposit', 'depositPaid', 'acconto',
        'cauzione', 'amountPaid', 'amount', 'paymentStatus', 'originalCurrency',
        'originalCost', 'originalDepositPaid', 'originalDepositCurrency', 'depositExchangeRate', 'depositExchangeRateDate',
        'depositExchangeRateSource', 'originalRemaining', 'originalCauzione', 'originalCauzioneCurrency', 'exchangeRate',
        'exchangeRateDate', 'exchangeRateSource', 'conversionType', 'depositConversionType', 'convertedAt',
        'currencyUncertain', 'privateNested', 'noteCopilota', 'copilota', 'cancellazioneGratuitaEntro',
        'attachments'
      ]);
    }

    // Fail closed on historical leaks and unknown structured payloads. An editor
    // can still recover them; Viewer reads never expose raw legacy credentials.
    function publicScalar(value) {
      return !(value is map) && !(value is list);
    }
    function publicCoordinates(value) {
      return value == null || (value is map && value.keys().hasOnly(['lat', 'lng'])
        && value.get('lat', 0) is number && value.get('lng', 0) is number);
    }
    // BEGIN OPERATIONAL VIEWER VALIDATORS
    function publicReferenceSlot(value, index) {
      return value.size() <= index || (value[index] is string && value[index].matches('^[A-Za-z0-9_-]{1,128}$'));
    }
    function publicDocumentReferences(value) {
      return value == null || (value is list && value.size() <= 32
        && publicReferenceSlot(value, 0)
        && publicReferenceSlot(value, 1)
        && publicReferenceSlot(value, 2)
        && publicReferenceSlot(value, 3)
        && publicReferenceSlot(value, 4)
        && publicReferenceSlot(value, 5)
        && publicReferenceSlot(value, 6)
        && publicReferenceSlot(value, 7)
        && publicReferenceSlot(value, 8)
        && publicReferenceSlot(value, 9)
        && publicReferenceSlot(value, 10)
        && publicReferenceSlot(value, 11)
        && publicReferenceSlot(value, 12)
        && publicReferenceSlot(value, 13)
        && publicReferenceSlot(value, 14)
        && publicReferenceSlot(value, 15)
        && publicReferenceSlot(value, 16)
        && publicReferenceSlot(value, 17)
        && publicReferenceSlot(value, 18)
        && publicReferenceSlot(value, 19)
        && publicReferenceSlot(value, 20)
        && publicReferenceSlot(value, 21)
        && publicReferenceSlot(value, 22)
        && publicReferenceSlot(value, 23)
        && publicReferenceSlot(value, 24)
        && publicReferenceSlot(value, 25)
        && publicReferenceSlot(value, 26)
        && publicReferenceSlot(value, 27)
        && publicReferenceSlot(value, 28)
        && publicReferenceSlot(value, 29)
        && publicReferenceSlot(value, 30)
        && publicReferenceSlot(value, 31));
    }
    function validDocumentPublication(data) {
      return (!('linkedDocumentId' in data) || data.linkedDocumentId == null
          || data.linkedDocumentId in data.get('publicDocumentIds', []))
        && (!('linkedDocumentIds' in data) || data.linkedDocumentIds == null
          || data.linkedDocumentIds.hasOnly(data.get('publicDocumentIds', [])));
    }
    function publicHoursSlot(value, key) {
      return !(key in value) || (value[key] is string && value[key].size() <= 200);
    }
    function publicExceptionSlot(value, index) {
      return value.keys().size() <= index || (value.keys()[index].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && publicHoursSlot(value, value.keys()[index]));
    }
    function publicOpeningHours(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['status','accessType','weekly','exceptions','source','verifiedAt','timeZone','notes'])
        && value.status in ['unverified','manual','verified'] && value.accessType in ['unknown','attraction','outdoor']
        && (!('weekly' in value) || (value.weekly is map && value.weekly.keys().hasOnly(['sun','mon','tue','wed','thu','fri','sat'])
          && publicHoursSlot(value.weekly, 'sun')
          && publicHoursSlot(value.weekly, 'mon')
          && publicHoursSlot(value.weekly, 'tue')
          && publicHoursSlot(value.weekly, 'wed')
          && publicHoursSlot(value.weekly, 'thu')
          && publicHoursSlot(value.weekly, 'fri')
          && publicHoursSlot(value.weekly, 'sat')))
        && (!('exceptions' in value) || (value.exceptions is map && value.exceptions.size() <= 32
          && publicExceptionSlot(value.exceptions, 0)
          && publicExceptionSlot(value.exceptions, 1)
          && publicExceptionSlot(value.exceptions, 2)
          && publicExceptionSlot(value.exceptions, 3)
          && publicExceptionSlot(value.exceptions, 4)
          && publicExceptionSlot(value.exceptions, 5)
          && publicExceptionSlot(value.exceptions, 6)
          && publicExceptionSlot(value.exceptions, 7)
          && publicExceptionSlot(value.exceptions, 8)
          && publicExceptionSlot(value.exceptions, 9)
          && publicExceptionSlot(value.exceptions, 10)
          && publicExceptionSlot(value.exceptions, 11)
          && publicExceptionSlot(value.exceptions, 12)
          && publicExceptionSlot(value.exceptions, 13)
          && publicExceptionSlot(value.exceptions, 14)
          && publicExceptionSlot(value.exceptions, 15)
          && publicExceptionSlot(value.exceptions, 16)
          && publicExceptionSlot(value.exceptions, 17)
          && publicExceptionSlot(value.exceptions, 18)
          && publicExceptionSlot(value.exceptions, 19)
          && publicExceptionSlot(value.exceptions, 20)
          && publicExceptionSlot(value.exceptions, 21)
          && publicExceptionSlot(value.exceptions, 22)
          && publicExceptionSlot(value.exceptions, 23)
          && publicExceptionSlot(value.exceptions, 24)
          && publicExceptionSlot(value.exceptions, 25)
          && publicExceptionSlot(value.exceptions, 26)
          && publicExceptionSlot(value.exceptions, 27)
          && publicExceptionSlot(value.exceptions, 28)
          && publicExceptionSlot(value.exceptions, 29)
          && publicExceptionSlot(value.exceptions, 30)
          && publicExceptionSlot(value.exceptions, 31)))
        && (!('source' in value) || (value.source is string && value.source.size() <= 2048))
        && (!('verifiedAt' in value) || (value.verifiedAt is string && value.verifiedAt.size() <= 2048))
        && (!('timeZone' in value) || (value.timeZone is string && value.timeZone.size() <= 2048))
        && (!('notes' in value) || (value.notes is string && value.notes.size() <= 2048)));
    }
    function publicLayover(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['airport','duration','arrivalTime','departureTime','departureDate','arrivalDate','carrier','notes'])
        && (!('airport' in value) || value.airport is string)
        && (!('duration' in value) || value.duration is string)
        && (!('arrivalTime' in value) || value.arrivalTime is string)
        && (!('departureTime' in value) || value.departureTime is string)
        && (!('departureDate' in value) || value.departureDate is string)
        && (!('arrivalDate' in value) || value.arrivalDate is string)
        && (!('carrier' in value) || value.carrier is string)
        && (!('notes' in value) || value.notes is string));
    }
    function publicDocumentReference(value) { return value == null || (value is string && value.matches('^[A-Za-z0-9_-]{1,128}$')); }
    function viewer_giorni_0(data) {
      return (!('_enriched' in data) || publicScalar(data._enriched))
        && (!('address' in data) || publicScalar(data.address))
        && (!('category' in data) || publicScalar(data.category))
        && (!('completed' in data) || publicScalar(data.completed))
        && (!('coordinate' in data) || publicCoordinates(data.coordinate))
        && (!('createdAt' in data) || publicScalar(data.createdAt))
        && (!('data' in data) || publicScalar(data.data))
        && (!('date' in data) || publicScalar(data.date))
        && (!('dayId' in data) || publicScalar(data.dayId))
        && (!('deleted' in data) || publicScalar(data.deleted));
    }

    function viewer_giorni_1(data) {
      return (!('deletedAt' in data) || publicScalar(data.deletedAt))
        && (!('deletedBy' in data) || publicScalar(data.deletedBy))
        && (!('hasPrivateCredentials' in data) || publicScalar(data.hasPrivateCredentials))
        && (!('id' in data) || publicScalar(data.id))
        && (!('indirizzo' in data) || publicScalar(data.indirizzo))
        && (!('lastSanitizedAt' in data) || publicScalar(data.lastSanitizedAt))
        && (!('location' in data) || publicScalar(data.location))
        && (!('name' in data) || publicScalar(data.name))
        && (!('nome' in data) || publicScalar(data.nome))
        && (!('nota' in data) || publicScalar(data.nota));
    }

    function viewer_giorni_2(data) {
      return (!('notes' in data) || publicScalar(data.notes))
        && (!('orario' in data) || publicScalar(data.orario))
        && (!('publicSchemaVersion' in data) || publicScalar(data.publicSchemaVersion))
        && (!('sottocategoria' in data) || publicScalar(data.sottocategoria))
        && (!('status' in data) || publicScalar(data.status))
        && (!('time' in data) || publicScalar(data.time))
        && (!('timeStatus' in data) || publicScalar(data.timeStatus))
        && (!('title' in data) || publicScalar(data.title))
        && (!('titolo' in data) || publicScalar(data.titolo))
        && (!('updatedAt' in data) || publicScalar(data.updatedAt));
    }

    function viewer_giorni(data) {
      return data.keys().hasOnly(["_enriched","address","category","completed","coordinate","createdAt","data","date","dayId","deleted","deletedAt","deletedBy","hasPrivateCredentials","id","indirizzo","lastSanitizedAt","location","name","nome","nota","notes","orario","publicSchemaVersion","sottocategoria","status","time","timeStatus","title","titolo","updatedAt"])
        && viewer_giorni_0(data)
        && viewer_giorni_1(data)
        && viewer_giorni_2(data);
    }

    function viewer_tappe_0(data) {
      return (!('_enriched' in data) || publicScalar(data._enriched))
        && (!('address' in data) || publicScalar(data.address))
        && (!('category' in data) || publicScalar(data.category))
        && (!('completed' in data) || publicScalar(data.completed))
        && (!('coordinate' in data) || publicCoordinates(data.coordinate))
        && (!('createdAt' in data) || publicScalar(data.createdAt))
        && (!('data' in data) || publicScalar(data.data))
        && (!('date' in data) || publicScalar(data.date))
        && (!('dayId' in data) || publicScalar(data.dayId))
        && (!('deleted' in data) || publicScalar(data.deleted));
    }

    function viewer_tappe_1(data) {
      return (!('deletedAt' in data) || publicScalar(data.deletedAt))
        && (!('deletedBy' in data) || publicScalar(data.deletedBy))
        && (!('hasPrivateCredentials' in data) || publicScalar(data.hasPrivateCredentials))
        && (!('id' in data) || publicScalar(data.id))
        && (!('indirizzo' in data) || publicScalar(data.indirizzo))
        && (!('lastSanitizedAt' in data) || publicScalar(data.lastSanitizedAt))
        && (!('lightWindow' in data) || publicScalar(data.lightWindow))
        && (!('link' in data) || publicScalar(data.link))
        && (!('linkedBookingId' in data) || publicScalar(data.linkedBookingId))
        && (!('linkedDocumentId' in data) || publicDocumentReference(data.linkedDocumentId));
    }

    function viewer_tappe_2(data) {
      return (!('linkedDocumentIds' in data) || publicDocumentReferences(data.linkedDocumentIds))
        && (!('location' in data) || publicScalar(data.location))
        && (!('mapsUrl' in data) || publicScalar(data.mapsUrl))
        && (!('mostraNoteInCard' in data) || publicScalar(data.mostraNoteInCard))
        && (!('name' in data) || publicScalar(data.name))
        && (!('nome' in data) || publicScalar(data.nome))
        && (!('nota' in data) || publicScalar(data.nota))
        && (!('notes' in data) || publicScalar(data.notes))
        && (!('openingHours' in data) || publicOpeningHours(data.openingHours))
        && (!('orario' in data) || publicScalar(data.orario));
    }

    function viewer_tappe_3(data) {
      return (!('order' in data) || publicScalar(data.order))
        && (!('passeggiataId' in data) || publicScalar(data.passeggiataId))
        && (!('photoSubject' in data) || publicScalar(data.photoSubject))
        && (!('publicDocumentIds' in data) || publicDocumentReferences(data.publicDocumentIds))
        && (!('publicSchemaVersion' in data) || publicScalar(data.publicSchemaVersion))
        && (!('sottocategoria' in data) || publicScalar(data.sottocategoria))
        && (!('status' in data) || publicScalar(data.status))
        && (!('time' in data) || publicScalar(data.time))
        && (!('timeStatus' in data) || publicScalar(data.timeStatus))
        && (!('title' in data) || publicScalar(data.title));
    }

    function viewer_tappe_4(data) {
      return (!('titolo' in data) || publicScalar(data.titolo))
        && (!('updatedAt' in data) || publicScalar(data.updatedAt));
    }

    function viewer_tappe(data) {
      return data.keys().hasOnly(["_enriched","address","category","completed","coordinate","createdAt","data","date","dayId","deleted","deletedAt","deletedBy","hasPrivateCredentials","id","indirizzo","lastSanitizedAt","lightWindow","link","linkedBookingId","linkedDocumentId","linkedDocumentIds","location","mapsUrl","mostraNoteInCard","name","nome","nota","notes","openingHours","orario","order","passeggiataId","photoSubject","publicDocumentIds","publicSchemaVersion","sottocategoria","status","time","timeStatus","title","titolo","updatedAt"])
        && viewer_tappe_0(data)
        && viewer_tappe_1(data)
        && viewer_tappe_2(data)
        && viewer_tappe_3(data)
        && viewer_tappe_4(data);
    }

    function viewer_attivita_0(data) {
      return (!('_enriched' in data) || publicScalar(data._enriched))
        && (!('address' in data) || publicScalar(data.address))
        && (!('category' in data) || publicScalar(data.category))
        && (!('childTappe' in data) || publicScalar(data.childTappe))
        && (!('completed' in data) || publicScalar(data.completed))
        && (!('coordinate' in data) || publicCoordinates(data.coordinate))
        && (!('createdAt' in data) || publicScalar(data.createdAt))
        && (!('currency' in data) || publicScalar(data.currency))
        && (!('data' in data) || publicScalar(data.data))
        && (!('date' in data) || publicScalar(data.date));
    }

    function viewer_attivita_1(data) {
      return (!('dayId' in data) || publicScalar(data.dayId))
        && (!('deleted' in data) || publicScalar(data.deleted))
        && (!('deletedAt' in data) || publicScalar(data.deletedAt))
        && (!('deletedBy' in data) || publicScalar(data.deletedBy))
        && (!('destinationLocation' in data) || publicScalar(data.destinationLocation))
        && (!('difficulty' in data) || publicScalar(data.difficulty))
        && (!('distanceKm' in data) || publicScalar(data.distanceKm))
        && (!('duration' in data) || publicScalar(data.duration))
        && (!('elevationGainM' in data) || publicScalar(data.elevationGainM))
        && (!('endDate' in data) || publicScalar(data.endDate));
    }

    function viewer_attivita_2(data) {
      return (!('googleMapsUrl' in data) || publicScalar(data.googleMapsUrl))
        && (!('hasPrivateCredentials' in data) || publicScalar(data.hasPrivateCredentials))
        && (!('hikingDurationMinutes' in data) || publicScalar(data.hikingDurationMinutes))
        && (!('id' in data) || publicScalar(data.id))
        && (!('indirizzo' in data) || publicScalar(data.indirizzo))
        && (!('isRoute' in data) || publicScalar(data.isRoute))
        && (!('lastSanitizedAt' in data) || publicScalar(data.lastSanitizedAt))
        && (!('lightWindow' in data) || publicScalar(data.lightWindow))
        && (!('link' in data) || publicScalar(data.link))
        && (!('location' in data) || publicScalar(data.location));
    }

    function viewer_attivita_3(data) {
      return (!('mapsUrl' in data) || publicScalar(data.mapsUrl))
        && (!('mostraNoteInCard' in data) || publicScalar(data.mostraNoteInCard))
        && (!('name' in data) || publicScalar(data.name))
        && (!('nome' in data) || publicScalar(data.nome))
        && (!('nota' in data) || publicScalar(data.nota))
        && (!('notes' in data) || publicScalar(data.notes))
        && (!('openingHours' in data) || publicOpeningHours(data.openingHours))
        && (!('orario' in data) || publicScalar(data.orario))
        && (!('orarioInizio' in data) || publicScalar(data.orarioInizio))
        && (!('orarioRitrovo' in data) || publicScalar(data.orarioRitrovo));
    }

    function viewer_attivita_4(data) {
      return (!('order' in data) || publicScalar(data.order))
        && (!('originLocation' in data) || publicScalar(data.originLocation))
        && (!('photoSubject' in data) || publicScalar(data.photoSubject))
        && (!('platform' in data) || publicScalar(data.platform))
        && (!('publicSchemaVersion' in data) || publicScalar(data.publicSchemaVersion))
        && (!('routePreview' in data) || publicScalar(data.routePreview))
        && (!('routeType' in data) || publicScalar(data.routeType))
        && (!('sottocategoria' in data) || publicScalar(data.sottocategoria))
        && (!('status' in data) || publicScalar(data.status))
        && (!('time' in data) || publicScalar(data.time));
    }

    function viewer_attivita_5(data) {
      return (!('timeStatus' in data) || publicScalar(data.timeStatus))
        && (!('timeZone' in data) || publicScalar(data.timeZone))
        && (!('title' in data) || publicScalar(data.title))
        && (!('titolo' in data) || publicScalar(data.titolo))
        && (!('updatedAt' in data) || publicScalar(data.updatedAt));
    }

    function viewer_attivita(data) {
      return data.keys().hasOnly(["_enriched","address","category","childTappe","completed","coordinate","createdAt","currency","data","date","dayId","deleted","deletedAt","deletedBy","destinationLocation","difficulty","distanceKm","duration","elevationGainM","endDate","googleMapsUrl","hasPrivateCredentials","hikingDurationMinutes","id","indirizzo","isRoute","lastSanitizedAt","lightWindow","link","location","mapsUrl","mostraNoteInCard","name","nome","nota","notes","openingHours","orario","orarioInizio","orarioRitrovo","order","originLocation","photoSubject","platform","publicSchemaVersion","routePreview","routeType","sottocategoria","status","time","timeStatus","timeZone","title","titolo","updatedAt"])
        && viewer_attivita_0(data)
        && viewer_attivita_1(data)
        && viewer_attivita_2(data)
        && viewer_attivita_3(data)
        && viewer_attivita_4(data)
        && viewer_attivita_5(data);
    }

    function viewer_alloggi_0(data) {
      return (!('_enriched' in data) || publicScalar(data._enriched))
