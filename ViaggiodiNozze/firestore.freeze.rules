        && (!('orario' in data) || publicScalar(data.orario))
        && (!('phone' in data) || publicScalar(data.phone))
        && (!('publicSchemaVersion' in data) || publicScalar(data.publicSchemaVersion))
        && (!('sottocategoria' in data) || publicScalar(data.sottocategoria))
        && (!('status' in data) || publicScalar(data.status))
        && (!('time' in data) || publicScalar(data.time))
        && (!('timeStatus' in data) || publicScalar(data.timeStatus))
        && (!('timeZone' in data) || publicScalar(data.timeZone))
