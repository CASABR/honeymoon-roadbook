        && (!('id' in data) || publicScalar(data.id))
        && (!('indirizzo' in data) || publicScalar(data.indirizzo))
        && (!('lastSanitizedAt' in data) || publicScalar(data.lastSanitizedAt))
        && (!('location' in data) || publicScalar(data.location))
