        && (!('arrivalTime' in data) || publicScalar(data.arrivalTime))
        && (!('category' in data) || publicScalar(data.category))
        && (!('checkIn' in data) || publicScalar(data.checkIn))
        && (!('checkInAt' in data) || publicScalar(data.checkInAt))
        && (!('checkInDone' in data) || publicScalar(data.checkInDone))
        && (!('checkInTime' in data) || publicScalar(data.checkInTime))
        && (!('checkOut' in data) || publicScalar(data.checkOut))
        && (!('checkOutAt' in data) || publicScalar(data.checkOutAt));
