        && (!('note' in data) || publicScalar(data.note))
        && (!('notes' in data) || publicScalar(data.notes))
        && (!('orario' in data) || publicScalar(data.orario))
        && (!('passeggero' in data) || publicScalar(data.passeggero))
        && (!('pesoKg' in data) || publicScalar(data.pesoKg))
        && (!('publicSchemaVersion' in data) || publicScalar(data.publicSchemaVersion))
        && (!('sottocategoria' in data) || publicScalar(data.sottocategoria))
        && (!('status' in data) || publicScalar(data.status))
        && (!('time' in data) || publicScalar(data.time));
    }

    function viewer_bagagli_3(data) {
      return (!('timeStatus' in data) || publicScalar(data.timeStatus))
        && (!('tipo' in data) || publicScalar(data.tipo))
        && (!('title' in data) || publicScalar(data.title))
        && (!('titolo' in data) || publicScalar(data.titolo))
        && (!('updatedAt' in data) || publicScalar(data.updatedAt))
        && (!('verificato' in data) || publicScalar(data.verificato))
        && (!('voloId' in data) || publicScalar(data.voloId))
        && (!('voloTitle' in data) || publicScalar(data.voloTitle));
    }

    function viewer_bagagli(data) {
      return data.keys().hasOnly(["_enriched","address","category","completed","coordinate","createdAt","data","date","dayId","deleted","deletedAt","deletedBy","descrizione","hasPrivateCredentials","id","indirizzo","lastSanitizedAt","location","name","nome","nota","note","notes","orario","passeggero","pesoKg","publicSchemaVersion","sottocategoria","status","time","timeStatus","tipo","title","titolo","updatedAt","verificato","voloId","voloTitle"])
        && viewer_bagagli_0(data)
        && viewer_bagagli_1(data)
        && viewer_bagagli_2(data)
        && viewer_bagagli_3(data);
    }

    function safeSharedViewerDocument(data, subcol) {
      return (subcol == 'attivita' && viewer_attivita(data)) ||
        (subcol == 'tappe' && validDocumentPublication(data) && viewer_tappe(data)) ||
        (subcol == 'giorni' && viewer_giorni(data)) ||
        (subcol == 'alloggi' && viewer_alloggi(data)) ||
        (subcol == 'trasporti' && viewer_trasporti(data)) ||
        (subcol == 'ristoranti' && viewer_ristoranti(data)) ||
        (subcol == 'shopping' && viewer_shopping(data)) ||
        (subcol == 'bagagli' && viewer_bagagli(data));
    }

    // =========================================================================
    // 1. VIAGGI (TRIPS) E SOTTOCOLLEZIONI PRIVATE
    // =========================================================================

    match /trips/{tripId} {
      
      // Lettura di un singolo viaggio per ID: consentita SOLO ai membri effettivi o all'Admin globale verificato
      // (Gli estranei con solo tripId NON possono leggere né il viaggio né i suoi dati privati)
      allow get: if isSignedIn() && (
        (isTripMember(tripId) && hasNoSensitiveKeys(resource.data))
        || isTripPrivilegedMember(tripId)
        || isGlobalAdmin()
      );

      // Scansione e interrogazione dell'intera collezione viaggi (riservata all'Admin globale verificato):
      allow list: if isGlobalAdmin();

      // Creazione di un nuovo viaggio:
      // L'utente autenticato deve dichiararsi come ownerUid/ownerId e includersi nei members.
      allow create: if isSignedIn()
                      && hasNoSensitiveKeys(request.resource.data)
                      && (request.resource.data.get('ownerUid', null) == request.auth.uid || request.resource.data.get('ownerId', null) == request.auth.uid)
                      && (!('members' in request.resource.data) || request.auth.uid in request.resource.data.members);

      // Modifica del viaggio:
      // Riservata all'owner; i membri ordinari possono aggiornare solo senza toccare members o primaryDeviceUid.
      // Auto-join copilota: consentito SOLO con prova crittografica verificata (batch con membro autorizzato) e mai per il viaggio 0000
      allow update: if isSignedIn()
                    && hasNoSensitiveKeys(request.resource.data)
                    && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
                    && (
                      isTripOwner(tripId)
                      || (isGlobalAdmin() && tripId != '0000')
                      ||
                      (
                        isTripMember(tripId)
                        && request.resource.data.get('primaryDeviceUid', null) == resource.data.get('primaryDeviceUid', null)
                        && request.resource.data.get('members', []) == resource.data.get('members', [])
                      )
                      ||
                      (
                        tripId != '0000'
                        && ! (request.auth.uid in resource.data.get('members', []))
                        && !exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
                        && request.auth.uid in request.resource.data.members
                        && request.resource.data.members.size() == resource.data.get('members', []).size() + 1
                        && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') == 'copilota'
                        && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('uid', request.auth.uid) == request.auth.uid
                      )
                    );

      // Eliminazione: solo l'owner (blocco assoluto per il viaggio reale protetto 0000)
      allow delete: if isTripOwner(tripId) && tripId != '0000';

      // -----------------------------------------------------------------------
      // 1.0 SOTTOCOLLEZIONE INVITI: /trips/{tripId}/invites/{inviteToken} (P0-B)
      // -----------------------------------------------------------------------
      match /invites/{inviteToken} {
        // Lettura del singolo invito consentita con token esatto per verifica prima del join
        // (List/scansione vietata ai non-owner: nessuno può enumerare o cercare token altrui)
        allow get: if isSignedIn()
                   && (
                     isTripOwner(tripId)
                     || (resource.data.inviteToken == inviteToken && resource.data.status in ['active', 'used'])
                   );
        allow list: if isTripOwner(tripId) || isGlobalAdmin();

        // Creazione dell'invito: solo l'owner del viaggio, token ad alta entropia, mai per il viaggio 0000
        allow create: if tripId != '0000'
                      && isTripOwner(tripId)
                      && request.resource.data.keys().hasOnly(['inviteToken', 'tripId', 'tripTitle', 'ownerName', 'role', 'createdBy', 'createdAt', 'expiresAt', 'status', 'usedBy', 'usedAt'])
                      && request.resource.data.inviteToken == inviteToken
                      && request.resource.data.tripId == tripId
                      && request.resource.data.role == 'copilota'
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.status == 'active'
                      && request.resource.data.expiresAt > request.time;

        // Riscatto (da parte dell'invitato nel batch atomico) o Revoca (da parte dell'owner)
        allow update: if tripId != '0000'
                      && (
                        isTripOwner(tripId)
                        ||
                        (isSignedIn()
                         && resource.data.status == 'active'
                         && resource.data.expiresAt > request.time
                         && request.resource.data.status == 'used'
                         && request.resource.data.usedBy == request.auth.uid
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt']))
                      );
        allow delete: if tripId != '0000' && (isTripOwner(tripId) || isGlobalAdmin());
      }

      // -----------------------------------------------------------------------
      // 1.1 SOTTOCOLLEZIONE MEMBERS: /trips/{tripId}/members/{uid}
      // -----------------------------------------------------------------------
      match /members/{uid} {
        // Lettura: consentita ai membri effettivi del viaggio o all'Admin globale autorizzato per la dashboard
        allow read: if isTripMember(tripId) || isGlobalAdmin();

        // Creazione:
        // L'owner può registrare membri. Un utente invitato può auto-registrarsi SOLO presentando
        // prova crittografica (inviteToken attivo e valido riscattato atomicamente nello stesso batch).
        allow create: if isSignedIn()
                        && request.resource.data.get('uid', uid) == uid
                        && request.resource.data.get('role', '') in ['owner', 'copilota']
                        && (
                          // 1. Owner all'atto di creazione del viaggio
                          ((uid == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null)
                            || uid == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null))
                           && request.resource.data.get('role', '') == 'owner'
                           && (isTripOwner(tripId) || uid == request.auth.uid))
                          ||
                          // 2. Assegnazione diretta da parte dell'Owner del viaggio o Admin globale (escluso 0000)
                          ((isTripOwner(tripId) || (isGlobalAdmin() && tripId != '0000')) && request.resource.data.get('role', '') == 'copilota')
                          ||
                          // 3. Riscatto crittografico con token valido in batch atomico (P0-B)
                          (
                            tripId != '0000'
                            && uid == request.auth.uid
                            && resource == null
                            && request.resource.data.get('role', '') == 'copilota'
                            && request.resource.data.get('inviteToken', '') != ''
                            && exists(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.resource.data.get('inviteToken', 'none')))
                            && get(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.resource.data.get('inviteToken', 'none'))).data.status == 'active'
                            && getAfter(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.resource.data.get('inviteToken', 'none'))).data.status == 'used'
                            && getAfter(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.resource.data.get('inviteToken', 'none'))).data.usedBy == request.auth.uid
                          )
                        );

        // Modifica: consentita all'owner, all'Admin globale (non-0000) o al membro stesso per il proprio profilo (role e uid immutabili)
        allow update: if isSignedIn()
                        && (isTripOwner(tripId) || (isGlobalAdmin() && tripId != '0000') || (request.auth.uid == uid && isTripMember(tripId)))
                        && request.resource.data.get('uid', resource.data.get('uid', uid)) == resource.data.get('uid', uid)
                        && request.resource.data.role == resource.data.role;

        // Eliminazione: consentita all'owner effettivo o Admin globale su viaggi non-0000 (l'owner non può mai essere eliminato e 0000 è protetto)
        allow delete: if tripId != '0000'
                        && isSignedIn()
                        && resource.data.role != 'owner'
                        && (isTripOwner(tripId) || (isGlobalAdmin() && tripId != '0000'));
      }

      // -----------------------------------------------------------------------
      // 1.2 SOTTOCOLLEZIONE INVITE TOKENS: /trips/{tripId}/inviteTokens/{tokenId}
      // -----------------------------------------------------------------------
      match /inviteTokens/{tokenId} {
        // Solo l'owner del viaggio può visualizzare o creare/revocare token di invito per il suo viaggio.
        allow read, write: if isTripOwner(tripId) && tripId != '0000';
      }

      // -----------------------------------------------------------------------
      // 1.3 SOTTOCOLLEZIONI DATI PRIVATI DEL VIAGGIO
      // -----------------------------------------------------------------------
      // 1.2.B CASSAFORTE CREDENZIALI PRIVATE E COLLEZIONI RISERVATE (DEFINITIVO)
      match /private_credentials/{docId} {
        allow read, write: if isTripPrivilegedMember(tripId);
      }
      match /documenti/{docId} {
        allow read, write: if isTripPrivilegedMember(tripId);
      }
      match /spese/{docId} {
        allow read, write: if isTripPrivilegedMember(tripId);
      }
      match /note/{docId} {
        allow read, write: if isTripPrivilegedMember(tripId);
      }

      // 1.3 SOTTOCOLLEZIONI CONDIVISE (DATI SANIFICATI: LETTURA MEMBRI APERTA, SCHEMA GUARD ATTIVO)
      match /attivita/{docId} {
        allow get: if isSignedIn() && (
          (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') in ['owner', 'copilota']
            || viewer_attivita(resource.data)
          ))
          ||
          (exists(/databases/$(database)/documents/trips/$(tripId)) && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
            || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
            || (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('members', [])
                && viewer_attivita(resource.data))
          ))
        );

        allow list: if isTripMember(tripId)
          && (isTripPrivilegedMember(tripId) || resource.data.publicSchemaVersion == 2);

        allow create: if isTripPrivilegedMember(tripId)
          && request.resource.data.get('publicSchemaVersion', 0) is int
          && (
            (request.resource.data.get('publicSchemaVersion', 0) == 2
              && viewer_attivita(request.resource.data))
            ||
            (request.resource.data.get('publicSchemaVersion', 0) != 2
              && hasNoSensitiveKeys(request.resource.data))
          );

        // Impedisce ai client legacy 1.5.16 di rimuovere il marker v2 dai record già bonificati
        allow update: if isTripPrivilegedMember(tripId)
          && request.resource.data.get('publicSchemaVersion', 0) is int
          && (
            (request.resource.data.get('publicSchemaVersion', 0) == 2
              && viewer_attivita(request.resource.data))
            ||
            (request.resource.data.get('publicSchemaVersion', 0) != 2
              && hasNoSensitiveKeys(request.resource.data)
              && resource.data.get('publicSchemaVersion', 0) != 2)
          );

        allow delete: if isTripPrivilegedMember(tripId);
      }

      match /{subcol}/{docId} {
        allow get: if subcol in [
                         'tappe', 'alloggi', 'trasporti',
                         'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping',
                         'locks', 'devices'
                       ]
                       && isTripMember(tripId)
                       && (isTripPrivilegedMember(tripId) ||
                           (subcol != 'settings' && subcol != 'devices' && subcol != 'locks'
                            && safeSharedViewerDocument(resource.data, subcol)));

        // Collection queries must prove the schema marker. Per-document key checks
        // alone do not constrain a Firestore query over historical records.
        allow list: if subcol in ['tappe', 'alloggi', 'trasporti', 'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping', 'locks', 'devices']
          && isTripMember(tripId)
          && (isTripPrivilegedMember(tripId) ||
              (subcol in ['tappe', 'alloggi', 'trasporti', 'bagagli', 'giorni', 'ristoranti', 'shopping']
               && resource.data.publicSchemaVersion == 2));

        allow create: if subcol in [
                           'tappe', 'alloggi', 'trasporti',
                           'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping',
                           'locks', 'devices'
                         ]
                         && isTripPrivilegedMember(tripId)
                         && request.resource.data.get('publicSchemaVersion', 0) is int
                         && ((request.resource.data.get('publicSchemaVersion', 0) == 2
                              && safeSharedViewerDocument(request.resource.data, subcol))
                             || (request.resource.data.get('publicSchemaVersion', 0) != 2
                                 && hasNoSensitiveKeys(request.resource.data)));

        // Impedisce ai client legacy 1.5.16 di rimuovere il marker v2 dai record già bonificati
        allow update: if subcol in [
                           'tappe', 'alloggi', 'trasporti',
                           'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping',
                           'locks', 'devices'
                         ]
                         && isTripPrivilegedMember(tripId)
                         && request.resource.data.get('publicSchemaVersion', 0) is int
                         && ((request.resource.data.get('publicSchemaVersion', 0) == 2
                              && safeSharedViewerDocument(request.resource.data, subcol))
                             || (request.resource.data.get('publicSchemaVersion', 0) != 2
                                 && hasNoSensitiveKeys(request.resource.data)
                                 && (!(subcol in [
                                       'tappe', 'alloggi', 'trasporti',
                                       'bagagli', 'giorni', 'ristoranti', 'shopping'
                                     ])
                                     || resource.data.get('publicSchemaVersion', 0) != 2)));

        allow delete: if subcol in [
                           'tappe', 'alloggi', 'trasporti',
                           'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping',
                           'locks', 'devices'
                         ]
                         && isTripPrivilegedMember(tripId);
      }
    }

    // =========================================================================
    // 2. TOKEN INVITO GLOBALI (per lookup O(1) lato Cloud Function)
    // =========================================================================
    match /invite_tokens/{tokenHash} {
      // Accessibile SOLO via backend / Cloud Functions con Firebase Admin SDK.
      // Nessun client può leggere o manipolare i token hashati direttamente.
      allow read, write: if false;
    }

    // Inviti legacy:
    match /invites/{inviteId} {
      // Lettura permessa per eventuale transizione se autenticati, ma nessuna scrittura client
      allow read: if isSignedIn();
      allow write: if false;
    }

    // =========================================================================
    // 3. LIVE FEEDS (PUBBLICO)
    // =========================================================================
    function validPublicNextTransport(data) {
      return data is map
             && data.keys().hasOnly([
               'type',
               'fromLabel',
               'toLabel',
               'date',
               'departureTime',
               'timeZone',
               'departureUtcMs',
               'serviceNumber'
             ])
             && data.type in ['volo', 'treno', 'traghetto']
             && data.fromLabel is string && data.fromLabel.size() <= 100
             && data.toLabel is string && data.toLabel.size() <= 100
             && data.date is string && data.date.size() == 10
             && data.departureTime is string && data.departureTime.size() <= 5
             && data.timeZone is string && data.timeZone.size() <= 64
             && data.departureUtcMs is number && data.departureUtcMs > 0
             && (!('serviceNumber' in data) || (data.serviceNumber is string && data.serviceNumber.size() <= 32));
    }

    function validPublicTransportToken(item) {
      return item is string
             && item.size() <= 360
             && item.matches('^(volo|treno|traghetto)\\|[^|\\r\\n]{1,100}\\|[^|\\r\\n]{1,100}\\|[0-9]{4}-[0-9]{2}-[0-9]{2}\\|[0-9]{1,2}:[0-9]{2}\\|[A-Za-z0-9/_+-]{1,64}\\|[0-9]{10,15}\\|[A-Za-z0-9 .-]{0,32}$')
             && !item.matches('.*(?i)\\b(pnr|booking|codice|ticket|eticket|passport|passaporto|secret)\\b.*');
    }

    function validPublicUpcomingSlot(items, idx) {
      return items.size() <= idx || validPublicTransportToken(items[idx]);
    }

    function validPublicUpcomingTransports(items) {
      return items is list
             && items.size() <= 12
             && validPublicUpcomingSlot(items, 0)
             && validPublicUpcomingSlot(items, 1)
             && validPublicUpcomingSlot(items, 2)
             && validPublicUpcomingSlot(items, 3)
             && validPublicUpcomingSlot(items, 4)
             && validPublicUpcomingSlot(items, 5)
             && validPublicUpcomingSlot(items, 6)
             && validPublicUpcomingSlot(items, 7)
             && validPublicUpcomingSlot(items, 8)
             && validPublicUpcomingSlot(items, 9)
             && validPublicUpcomingSlot(items, 10)
             && validPublicUpcomingSlot(items, 11);
    }

    function validFeedHeader(data) {
      return data.keys().hasOnly(['title', 'coverPhotoUrl', 'status', 'currentCity', 'lastUpdateAt', 'statusMessage', 'statusUpdatedAt', 'nextTransport', 'upcomingTransports'])
             && (!('status' in data) || data.status in ['in_corso', 'completato'])
             && (!('title' in data) || (data.title is string && data.title.size() <= 120))
             && (!('coverPhotoUrl' in data) || (data.coverPhotoUrl is string && data.coverPhotoUrl.size() <= 2048))
             && (!('currentCity' in data) || (data.currentCity is string && data.currentCity.size() <= 120))
             && (!('statusMessage' in data) || (data.statusMessage is string && data.statusMessage.size() <= 1000))
             && (!('lastUpdateAt' in data) || data.lastUpdateAt is number)
             && (!('statusUpdatedAt' in data) || data.statusUpdatedAt is number)
             && (!('nextTransport' in data) || data.nextTransport == null || validPublicNextTransport(data.nextTransport))
             && (!('upcomingTransports' in data) || data.upcomingTransports == null || validPublicUpcomingTransports(data.upcomingTransports));
    }

    function validLiveUpdate(data) {
      return data.keys().hasOnly(['title', 'text', 'photoUrl', 'timestamp', 'locationName', 'reactionCounts', 'deleted', 'deletedAt', 'deletedBy', 'publicSchemaVersion'])
             && data.get('publicSchemaVersion', 0) in [0, 2]
             && data.get('publicSchemaVersion', 0) is int
             && data.timestamp is number
             && data.title is string && data.title.size() > 0 && data.title.size() <= 120
             && (!('text' in data) || (data.text is string && data.text.size() <= 1000))
             && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048))
             && (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 120))
             && (!('reactionCounts' in data) || (data.reactionCounts is map
                 && data.reactionCounts.keys().hasOnly(['❤️', '😍', '😂', '👋'])
                 && data.reactionCounts.get('❤️', 0) is number
                 && data.reactionCounts.get('😍', 0) is number
                 && data.reactionCounts.get('😂', 0) is number
                 && data.reactionCounts.get('👋', 0) is number))
             && (!('deleted' in data) || data.deleted is bool)
             && (!('deletedAt' in data) || data.deletedAt is number)
             && (!('deletedBy' in data) || (data.deletedBy is string && data.deletedBy.size() <= 128));
    }

    function isGpsGuideEligible(tripId, uid) {
      return exists(/databases/$(database)/documents/trips/$(tripId))
             && (
               get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == uid
               || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == uid
               || (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(uid))
                   && get(/databases/$(database)/documents/trips/$(tripId)/members/$(uid)).data.get('role', '') in ['owner', 'copilota'])
             );
    }

    function validGpsLease(data, tripId) {
      return data.keys().hasOnly(['holderUid', 'holderDeviceId', 'status', 'updatedAt', 'expiresAt'])
             && isGpsGuideEligible(tripId, data.holderUid)
             && data.holderDeviceId is string
             && data.holderDeviceId.size() >= 16
             && data.holderDeviceId.size() <= 128
             && data.status in ['active', 'paused', 'stopped']
             && data.updatedAt == request.time
             && data.expiresAt is timestamp
             && data.expiresAt > request.time
             && data.expiresAt <= request.time + duration.value(36, 'h');
    }

    function gpsLeaseDoc(tripId) {
      return exists(/databases/$(database)/documents/live_feeds/$(tripId)/gps_control/current)
        ? get(/databases/$(database)/documents/live_feeds/$(tripId)/gps_control/current).data
        : getAfter(/databases/$(database)/documents/live_feeds/$(tripId)/gps_control/current).data;
    }

    function gpsLease(tripId) {
      return gpsLeaseDoc(tripId);
    }

    function validGpsLocationShape(data) {
      return data.keys().hasOnly(['lat', 'lng', 'accuracy', 'city', 'country', 'updatedAt', 'publisherDeviceId', 'status'])
             && data.lat is number && data.lat >= -90 && data.lat <= 90
             && data.lng is number && data.lng >= -180 && data.lng <= 180
             && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000
             && data.city is string && data.city.size() <= 120
             && data.country is string && data.country.size() <= 120
             && data.publisherDeviceId is string
             && data.publisherDeviceId.size() >= 16
             && data.publisherDeviceId.size() <= 128
             && data.status in ['active', 'paused', 'stopped']
             && data.updatedAt is timestamp;
    }

    function validGpsLocation(data) {
      return validGpsLocationShape(data) && data.updatedAt == request.time;
    }

    function validGuestMessage(data) {
      return data.keys().hasOnly(['visitorId', 'authorName', 'message', 'createdAt', 'hidden', 'deleted', 'deletedAt', 'deletedBy', 'moderatedAt', 'publicSchemaVersion'])
             && data.get('publicSchemaVersion', 0) in [0, 2]
             && data.get('publicSchemaVersion', 0) is int
             && data.visitorId is string && data.visitorId.size() >= 4 && data.visitorId.size() <= 128
             && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40
             && data.message is string && data.message.size() >= 1 && data.message.size() <= 280
             && data.createdAt is number
             && data.hidden is bool
             && data.get('deleted', false) is bool
             && (!('deletedAt' in data) || data.deletedAt is number)
             && (!('deletedBy' in data) || data.deletedBy is string)
             && (!('moderatedAt' in data) || data.moderatedAt is number);
    }

    match /live_feeds/{tripId} {
      // Chiunque può leggere il feed pubblico
      allow get: if isTripPrivilegedMember(tripId) || validFeedHeader(resource.data);
      allow list: if isGlobalAdmin();
      allow create, update: if isTripPrivilegedMember(tripId) && validFeedHeader(request.resource.data);
      allow delete: if isTripOwner(tripId) && tripId != '0000';

      // Isolated public projection: only a coarse point and timestamp, never itinerary records.
      match /planned_location/{projectionId} {
        allow get: if projectionId == 'current' && (resource == null ||
          (resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt']) && resource.data.updatedAt is number
            && ((!('lat' in resource.data) && !('lng' in resource.data))
                || (resource.data.lat is number && resource.data.lng is number
                    && resource.data.lat >= -90 && resource.data.lat <= 90
                    && resource.data.lng >= -180 && resource.data.lng <= 180))));
        allow list: if false;
        allow create, update: if projectionId == 'current'
          && isTripOwner(tripId)
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt'])
          && request.resource.data.updatedAt is number
          && request.resource.data.updatedAt >= request.time.toMillis() - 120000
          && request.resource.data.updatedAt <= request.time.toMillis() + 120000
          && ((!('lat' in request.resource.data) && !('lng' in request.resource.data))
              || (request.resource.data.lat is number && request.resource.data.lng is number
                  && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                  && request.resource.data.lng >= -180 && request.resource.data.lng <= 180));
        allow delete: if false;
      }

      match /updates/{updateId} {
        allow get: if isTripPrivilegedMember(tripId) || validLiveUpdate(resource.data);
        allow list: if isTripPrivilegedMember(tripId) || resource.data.publicSchemaVersion == 2;
        allow create, update: if isTripPrivilegedMember(tripId) && validLiveUpdate(request.resource.data);
        allow delete: if isTripPrivilegedMember(tripId) && tripId != '0000';
        
        match /reactions/{reactionId} {
          allow read: if isTripPrivilegedMember(tripId);
          allow create, update: if request.resource.data.type in ['❤️', '😍', '😂', '👋']
                        && request.resource.data.visitorId == reactionId
                        && request.resource.data.keys().hasOnly(['type', 'visitorId', 'timestamp']);
          allow delete: if false;
        }

        match /comments/{commentId} {
          allow get, list: if isTripPrivilegedMember(tripId)
                           || (resource.data.publicSchemaVersion == 2 && resource.data.deleted == false);
          allow create: if isSignedIn() && isTripPrivilegedMember(tripId)
                        && request.resource.data.publicSchemaVersion == 2
                        && request.resource.data.deleted == false
                        && request.resource.data.authorName is string
                        && request.resource.data.authorName.size() >= 1
                        && request.resource.data.authorName.size() <= 40
                        && request.resource.data.text is string
                        && request.resource.data.text.size() >= 1
                        && request.resource.data.text.size() <= 280
                        && request.resource.data.createdAt is int
                        && request.resource.data.keys().hasOnly(['authorName', 'text', 'createdAt', 'deleted', 'publicSchemaVersion']);
          allow update: if isTripPrivilegedMember(tripId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text', 'deletedAt', 'deletedBy']);
          allow delete: if isTripPrivilegedMember(tripId) && tripId != '0000';
        }
      }

      match /guest_messages/{msgId} {
        // Lettura pubblica consentita ESCLUSIVAMENTE per messaggi non nascosti e non eliminati.
        // I messaggi nascosti o eliminati sono leggibili unicamente dagli sposi (Owner/Copilota) o dall'Admin.
        allow get: if (resource.data.get('hidden', false) == false && resource.data.get('deleted', false) == false
                       && validGuestMessage(resource.data)) || isTripPrivilegedMember(tripId) || isGlobalAdmin();
        allow list: if (resource.data.publicSchemaVersion == 2 && resource.data.hidden == false && resource.data.deleted == false)
                    || isTripPrivilegedMember(tripId) || isGlobalAdmin();
        // Scrittura diretta non autenticata disabilitata per prevenire abusi e flood su Firebase Spark.
        // Riservata a Owner e Copilota del viaggio (es. saluti/benvenuto) fino all'integrazione di un rate-limiter autoritativo.
        allow create: if isSignedIn() && isTripPrivilegedMember(tripId) && validGuestMessage(request.resource.data) && request.resource.data.hidden == false;
        allow update: if (isTripPrivilegedMember(tripId) || isGlobalAdmin()) && validGuestMessage(request.resource.data);
        allow delete: if (isTripPrivilegedMember(tripId) || isGlobalAdmin()) && tripId != '0000';
      }
      match /gps_control/{controlId} {
        allow read: if controlId == 'current'
                    && isSignedIn()
                    && isGpsGuideEligible(tripId, request.auth.uid);
        allow create: if controlId == 'current'
                      && isTripOwner(tripId)
                      && validGpsLease(request.resource.data, tripId);
        allow update: if controlId == 'current'
                      && validGpsLease(request.resource.data, tripId)
                      && (
                        isTripOwner(tripId)
                        || (request.auth.uid == resource.data.holderUid
                            && request.resource.data.holderUid == resource.data.holderUid
                            && (request.resource.data.holderDeviceId == resource.data.holderDeviceId
                                || resource.data.holderDeviceId == ('delegated_pending_' + resource.data.holderUid))
                            && request.resource.data.expiresAt == resource.data.expiresAt
                            && resource.data.expiresAt > request.time
                            && request.resource.data.status in ['active', 'paused', 'stopped'])
                      );
        allow delete: if false;
      }

      match /locations/{locationId} {
        allow read: if locationId == 'current'
                    && (
                        (validGpsLocationShape(resource.data)
                         && resource.data.status == 'active'
                       && resource.data.updatedAt > request.time - duration.value(15, 'm')
                       && gpsLease(tripId).status == 'active'
                       && gpsLease(tripId).expiresAt > request.time
                       && gpsLease(tripId).holderDeviceId == resource.data.publisherDeviceId)
                      || (isSignedIn() && isGpsGuideEligible(tripId, request.auth.uid))
                    );
        allow create: if locationId == 'current'
                      && isSignedIn()
                      && validGpsLocation(request.resource.data)
                      && request.resource.data.status == 'active'
                      && gpsLeaseDoc(tripId).holderUid == request.auth.uid
                      && gpsLeaseDoc(tripId).holderDeviceId == request.resource.data.publisherDeviceId
                      && gpsLeaseDoc(tripId).status == 'active'
                      && gpsLeaseDoc(tripId).expiresAt > request.time;
        allow update: if locationId == 'current'
                      && isSignedIn()
                      && validGpsLocation(request.resource.data)
                      && gpsLeaseDoc(tripId).holderDeviceId == request.resource.data.publisherDeviceId
                      && gpsLeaseDoc(tripId).expiresAt > request.time
                      && (
                        (request.resource.data.status == 'active'
                         && gpsLeaseDoc(tripId).holderUid == request.auth.uid
                         && gpsLeaseDoc(tripId).status == 'active'
                         && (resource.data.status != 'active' || resource.data.publisherDeviceId != request.resource.data.publisherDeviceId || resource.data.updatedAt <= request.time - duration.value(15, 's')))
                        || (request.resource.data.status in ['paused', 'stopped']
                            && gpsLeaseDoc(tripId).status == request.resource.data.status
                            && (gpsLeaseDoc(tripId).holderUid == request.auth.uid || isTripOwner(tripId))
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
                      );
        allow delete: if false;
      }
    }
    // =========================================================================
    // 4. PUSH SUBSCRIBERS
    // =========================================================================
    match /push_subscribers/{docId} {
      allow read, write: if false;
    }

    match /push_jobs/{docId} {
      allow read, write: if false;
    }

    match /push_dispatches/{docId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 5. SYSTEM ADMINS (ALLOWLIST SERVER-SIDE IMMUTABILE DAI CLIENT)
    // =========================================================================
    // Nessun client può leggere o scrivere /system_admins.
    // La gestione avviene esclusivamente in ambiente fidato (Admin SDK / Console).
    // L'utente autenticato può verificare esclusivamente se il PROPRIO UID è presente (self-check sicuro).
    // Nessun client può leggere l'elenco degli altri amministratori né scrivere o alterare record.
    // La gestione avviene esclusivamente in ambiente fidato (Firebase Console / Admin SDK).
    match /system_admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // =========================================================================
    // 6. USERS (PROFILI ED ACCESSO RECENTE UTENTE - FIREBASE SPARK)
    // =========================================================================
    // Ogni utente può aggiornare unicamente il proprio record.
    // L'Admin globale può leggere ed interrogare l'elenco utenti per la dashboard accessi.
    // L'utente ordinario può leggere unicamente il proprio profilo.
    // Nessun client può falsificare l'UID né impostare date alterate (richiesto request.time quando presente).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isGlobalAdmin());
      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId
                            && request.resource.data.keys().hasOnly(['uid', 'displayName', 'customDisplayName', 'isAnonymous', 'lastAccessAt', 'lastSeenAt', 'updatedAt', 'lastTripId', 'associatedTripIds'])
                            && (
                              !('lastAccessAt' in request.resource.data)
                              || request.resource.data.lastAccessAt == request.time
                            )
                            && (
                              !('lastSeenAt' in request.resource.data)
                              || request.resource.data.lastSeenAt == request.time
                            );
      allow delete: if false;
    }

  }
}
