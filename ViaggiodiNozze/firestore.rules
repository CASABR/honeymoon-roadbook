rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se l'utente autenticato è l'owner del viaggio
    function isTripOwner(tripId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/trips/$(tripId)) &&
         get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid)
        ||
        (existsAfter(/databases/$(database)/documents/trips/$(tripId)) &&
         getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid)
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') == 'owner')
      );
    }

    // Verifica se l'utente autenticato è membro effettivo (owner o member) del viaggio
    function isTripMember(tripId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)) && (
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('members', [])
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
        ))
      );
    }

    // Verifica se l'utente autenticato ha privilegi di Amministratore Globale
    function isGlobalAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
        || request.auth.token.get('admin', false) == true
      );
    }

    // =========================================================================
    // 1. VIAGGI (TRIPS) E SOTTOCOLLEZIONI PRIVATE
    // =========================================================================

    match /trips/{tripId} {
      
      // Lettura di un singolo viaggio per ID: consentita SOLO ai membri effettivi o all'Admin globale
      allow get: if isSignedIn() && (
        isTripMember(tripId)
        || isGlobalAdmin()
      );

      // Scansione e interrogazione dell'intera collezione viaggi (riservata all'Admin di sistema):
      allow list: if isGlobalAdmin();

      // Creazione di un nuovo viaggio:
      allow create: if isSignedIn()
                      && request.resource.data.ownerUid == request.auth.uid
                      && (!('members' in request.resource.data) || request.auth.uid in request.resource.data.members);

      // Modifica del viaggio:
      // Riservata all'owner o all'Admin Globale; i membri ordinari possono aggiornare solo senza toccare i members.
      // Nessun auto-join client consentito: l'owner deve pre-autorizzare l'UID del copilota.
      allow update: if isSignedIn()
                    && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
                    && (
                      isTripOwner(tripId)
                      || isGlobalAdmin()
                      ||
                      (
                        isTripMember(tripId)
                        && request.resource.data.get('primaryDeviceUid', null) == resource.data.get('primaryDeviceUid', null)
                        && request.resource.data.get('members', []) == resource.data.get('members', [])
                      )
                    );

      // Eliminazione: solo l'owner o l'Amministratore Globale (blocco assoluto per il viaggio reale protetto 0000)
      allow delete: if (isTripOwner(tripId) || isGlobalAdmin()) && tripId != '0000';

      // -----------------------------------------------------------------------
      // 1.1 SOTTOCOLLEZIONE MEMBERS: /trips/{tripId}/members/{uid}
      // -----------------------------------------------------------------------
      match /members/{uid} {
        // Lettura: consentita solo ai membri effettivi del viaggio o all'Admin globale autorizzato
        allow read: if isTripMember(tripId) || isGlobalAdmin();

        // Creazione:
        // L'owner o l'Admin Globale possono registrare membri. L'utente corrente può auto-registrarsi SOLO se
        // è già l'owner riconosciuto a livello di viaggio (bootstrap iniziale atomico in App.tsx).
        // Gli ingressi ordinari richiedono un UID gia autorizzato dall'owner.
        allow create: if isSignedIn()
                        && request.resource.data.uid == uid
                        && request.resource.data.get('role', '') in ['owner', 'copilota']
                        && (
                          (uid == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.ownerUid
                           && request.resource.data.get('role', '') == 'owner')
                          ||
                          (uid != getAfter(/databases/$(database)/documents/trips/$(tripId)).data.ownerUid
                           && request.resource.data.get('role', '') == 'copilota')
                        )
                        && (
                          isTripOwner(tripId)
                          || isGlobalAdmin()
                          ||
                          (
                            uid == request.auth.uid
                            && resource == null
                            && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerUid == request.auth.uid
                            && request.resource.data.get('role', '') == 'owner'
                          )
                        );

        // Modifica: consentita all'owner o all'Amministratore Globale
        allow update: if isSignedIn()
                        && (isTripOwner(tripId) || isGlobalAdmin())
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.role == resource.data.role;

        // Eliminazione: consentita al proprietario effettivo o all'Admin Globale
        // (il proprietario del viaggio non può mai essere eliminato: resource.data.role != 'owner')
        allow delete: if isSignedIn()
                        && resource.data.role != 'owner'
                        && (isTripOwner(tripId) || isGlobalAdmin());
      }

      // -----------------------------------------------------------------------
      // 1.2 SOTTOCOLLEZIONE INVITE TOKENS: /trips/{tripId}/inviteTokens/{tokenId}
      // -----------------------------------------------------------------------
      match /inviteTokens/{tokenId} {
        // Solo l'owner del viaggio o l'Admin globale possono visualizzare o revocare/eliminare token di invito.
        allow read, write: if (isTripOwner(tripId) || isGlobalAdmin()) && tripId != '0000';
      }

      // -----------------------------------------------------------------------
      // 1.3 SOTTOCOLLEZIONI DATI PRIVATI DEL VIAGGIO
      // -----------------------------------------------------------------------
      match /{subcol}/{docId} {
        allow read, write: if subcol in [
                               'tappe', 'attivita', 'alloggi', 'trasporti', 'spese',
                               'documenti', 'note', 'bagagli', 'giorni', 'settings',
                               'ristoranti', 'shopping', 'locks'
                             ]
                             && (isTripMember(tripId) || isGlobalAdmin());
      }
    }

    // =========================================================================
    // 2. TOKEN INVITO GLOBALI (per lookup O(1) lato Cloud Function)
    // =========================================================================
    match /invite_tokens/{tokenHash} {
      // Accessibile SOLO via backend / Cloud Functions con Firebase Admin SDK.
      // Nessun client può leggere o manipolare i token hashati direttamente.
      allow read, write: if false;
    }

    // =========================================================================
    // 2.1 AMMINISTRATORI DI SISTEMA (WHITELIST GLOBALE)
    // =========================================================================
    match /system_admins/{adminUid} {
      // Solo l'amministratore registrato può verificare la propria esistenza, nessuna scrittura client diretta
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    // Inviti legacy:
    match /invites/{inviteId} {
      // Lettura permessa per eventuale transizione se autenticati, ma nessuna scrittura client
      allow read: if isSignedIn();
      allow write: if false;
    }

    // =========================================================================
    // 3. LIVE FEEDS (PUBBLICO)
    // =========================================================================
    function validFeedHeader(data) {
      return data.keys().hasOnly(['title', 'coverPhotoUrl', 'status', 'currentCity', 'lastUpdateAt'])
             && (!('status' in data) || data.status in ['in_corso', 'completato'])
             && (!('title' in data) || (data.title is string && data.title.size() <= 120));
    }

    function validLiveUpdate(data) {
      return data.keys().hasOnly(['title', 'text', 'photoUrl', 'timestamp', 'locationName', 'reactionCounts'])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 120
             && (!('text' in data) || (data.text is string && data.text.size() <= 1000))
             && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048))
             && (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 120))
             && (!('reactionCounts' in data) || data.reactionCounts.keys().hasOnly(['❤️', '😍', '😂', '👋']));
    }

    match /live_feeds/{tripId} {
      // Chiunque può leggere il feed pubblico
      allow read: if true;
      allow create, update: if isTripMember(tripId) && validFeedHeader(request.resource.data);
      allow delete: if (isTripOwner(tripId) || isGlobalAdmin()) && tripId != '0000';

      match /updates/{updateId} {
        allow read: if true;
        allow create, update: if isTripMember(tripId) && validLiveUpdate(request.resource.data);
        allow delete: if (isTripMember(tripId) || isGlobalAdmin()) && tripId != '0000';
        
        match /reactions/{reactionId} {
          allow read: if isTripMember(tripId);
          allow create, update: if request.resource.data.type in ['❤️', '😍', '😂', '👋']
                        && request.resource.data.visitorId == reactionId
                        && request.resource.data.keys().hasOnly(['type', 'visitorId', 'timestamp']);
          allow delete: if false;
        }
      }
    }
    // =========================================================================
    // 4. PUSH SUBSCRIBERS
    // =========================================================================
    match /push_subscribers/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && isTripMember(request.resource.data.tripId);
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.tripId == resource.data.tripId
                    && request.resource.data.deviceId == docId
                    && isTripMember(resource.data.tripId);
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // =========================================================================
    // 5. SYSTEM ADMINS (ALLOWLIST SERVER-SIDE IMMUTABILE DAI CLIENT)
    // =========================================================================
    // Nessun client può leggere o scrivere /system_admins.
    // La gestione avviene esclusivamente in ambiente fidato (Admin SDK / Console).
    match /system_admins/{adminId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 6. USERS (PROFILI ED ULTIMO ACCESSO UTENTE - FIREBASE SPARK)
    // =========================================================================
    // Ogni utente può aggiornare unicamente il proprio record.
    // L'Admin globale può leggere ed interrogare l'elenco utenti per la dashboard accessi.
    // L'utente ordinario può leggere unicamente il proprio profilo.
    // Nessun client può falsificare l'UID né impostare date alterate (richiesto request.time quando presente).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isGlobalAdmin());
      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId
                            && request.resource.data.keys().hasOnly(['uid', 'displayName', 'isAnonymous', 'lastAccessAt', 'updatedAt', 'lastTripId', 'associatedTripIds'])
                            && (
                              !('lastAccessAt' in request.resource.data)
                              || request.resource.data.lastAccessAt == request.time
                            );
      allow delete: if false;
    }

  }
}
