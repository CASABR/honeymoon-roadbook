rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se l'utente autenticato è l'owner del viaggio
    function isTripOwner(tripId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/trips/$(tripId)) && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
        ||
        (existsAfter(/databases/$(database)/documents/trips/$(tripId)) && (
          getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') == 'owner')
      );
    }

    // Verifica se l'utente autenticato è membro effettivo (owner o member) del viaggio
    function isTripMember(tripId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)) && (
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('members', [])
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
      );
    }

    // Verifica se l'utente autenticato ha privilegi di Amministratore Globale
    function isGlobalAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
        || request.auth.token.get('admin', false) == true
      );
    }

    // =========================================================================
    // 1. VIAGGI (TRIPS) E SOTTOCOLLEZIONI PRIVATE
    // =========================================================================

    match /trips/{tripId} {
      
      // Lettura di un singolo viaggio per ID: consentita SOLO ai membri effettivi o all'Admin globale verificato
      // (Gli estranei con solo tripId NON possono leggere né il viaggio né i suoi dati privati)
      allow get: if isSignedIn() && (
        isTripMember(tripId)
        || isGlobalAdmin()
      );

      // Scansione e interrogazione dell'intera collezione viaggi (riservata all'Admin globale verificato):
      allow list: if isGlobalAdmin();

      // Creazione di un nuovo viaggio:
      // L'utente autenticato deve dichiararsi come ownerUid/ownerId e includersi nei members.
      allow create: if isSignedIn()
                      && (request.resource.data.get('ownerUid', null) == request.auth.uid || request.resource.data.get('ownerId', null) == request.auth.uid)
                      && (!('members' in request.resource.data) || request.auth.uid in request.resource.data.members);

      // Modifica del viaggio:
      // Riservata all'owner; i membri ordinari possono aggiornare solo senza toccare members o primaryDeviceUid.
      // Auto-join copilota: consentito SOLO con prova crittografica verificata (batch con membro autorizzato) e mai per il viaggio 0000
      allow update: if isSignedIn()
                    && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
                    && (
                      isTripOwner(tripId)
                      ||
                      (
                        isTripMember(tripId)
                        && request.resource.data.get('primaryDeviceUid', null) == resource.data.get('primaryDeviceUid', null)
                        && request.resource.data.get('members', []) == resource.data.get('members', [])
                      )
                      ||
                      (
                        tripId != '0000'
                        && ! (request.auth.uid in resource.data.get('members', []))
                        && !exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
                        && request.auth.uid in request.resource.data.members
                        && request.resource.data.members.size() == resource.data.get('members', []).size() + 1
                        && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'copilota'
                        && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.uid == request.auth.uid
                      )
                    );

      // Eliminazione: solo l'owner (blocco assoluto per il viaggio reale protetto 0000)
      allow delete: if isTripOwner(tripId) && tripId != '0000';

      // -----------------------------------------------------------------------
      // 1.0 SOTTOCOLLEZIONE INVITI: /trips/{tripId}/invites/{inviteToken} (P0-B)
      // -----------------------------------------------------------------------
      match /invites/{inviteToken} {
        // Lettura del singolo invito consentita con token esatto per verifica prima del join
        // (List/scansione vietata ai non-owner: nessuno può enumerare o cercare token altrui)
        allow get: if isSignedIn()
                   && (isTripOwner(tripId) || (resource.data.status == 'active' && resource.data.expiresAt > request.time));
        allow list: if isTripOwner(tripId) || isGlobalAdmin();

        // Creazione dell'invito: solo l'owner del viaggio, token ad alta entropia, mai per il viaggio 0000
        allow create: if tripId != '0000'
                      && isTripOwner(tripId)
                      && request.resource.data.keys().hasOnly(['inviteToken', 'tripId', 'tripTitle', 'ownerName', 'role', 'createdBy', 'createdAt', 'expiresAt', 'status', 'usedBy', 'usedAt'])
                      && request.resource.data.inviteToken == inviteToken
                      && request.resource.data.tripId == tripId
                      && request.resource.data.role == 'copilota'
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.status == 'active'
                      && request.resource.data.expiresAt > request.time;

        // Riscatto (da parte dell'invitato nel batch atomico) o Revoca (da parte dell'owner)
        allow update: if tripId != '0000'
                      && (
                        isTripOwner(tripId)
                        ||
                        (isSignedIn()
                         && resource.data.status == 'active'
                         && resource.data.expiresAt > request.time
                         && request.resource.data.status == 'used'
                         && request.resource.data.usedBy == request.auth.uid
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'usedAt']))
                      );
        allow delete: if tripId != '0000' && (isTripOwner(tripId) || isGlobalAdmin());
      }

      // -----------------------------------------------------------------------
      // 1.1 SOTTOCOLLEZIONE MEMBERS: /trips/{tripId}/members/{uid}
      // -----------------------------------------------------------------------
      match /members/{uid} {
        // Lettura: consentita ai membri effettivi del viaggio o all'Admin globale autorizzato per la dashboard
        allow read: if isTripMember(tripId) || isGlobalAdmin();

        // Creazione:
        // L'owner può registrare membri. Un utente invitato può auto-registrarsi SOLO presentando
        // prova crittografica (inviteToken attivo e valido riscattato atomicamente nello stesso batch).
        allow create: if isSignedIn()
                        && request.resource.data.uid == uid
                        && request.resource.data.get('role', '') in ['owner', 'copilota']
                        && (
                          // 1. Owner all'atto di creazione del viaggio
                          ((uid == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null)
                            || uid == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null))
                           && request.resource.data.get('role', '') == 'owner'
                           && (isTripOwner(tripId) || uid == request.auth.uid))
                          ||
                          // 2. Assegnazione diretta da parte dell'Owner del viaggio
                          (isTripOwner(tripId) && request.resource.data.get('role', '') == 'copilota')
                          ||
                          // 3. Riscatto crittografico con token valido in batch atomico (P0-B)
                          (
                            tripId != '0000'
                            && uid == request.auth.uid
                            && resource == null
                            && request.resource.data.get('role', '') == 'copilota'
                            && 'inviteToken' in request.resource.data
                            && exists(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.resource.data.inviteToken))
                            && getAfter(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.resource.data.inviteToken)).data.status == 'used'
                            && getAfter(/databases/$(database)/documents/trips/$(tripId)/invites/$(request.resource.data.inviteToken)).data.usedBy == request.auth.uid
                          )
                        );

        // Modifica: consentita unicamente all'owner (role e uid immutabili)
        allow update: if isSignedIn()
                        && isTripOwner(tripId)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.role == resource.data.role;

        // Eliminazione: consentita all'owner effettivo (l'owner del viaggio non può mai essere eliminato)
        allow delete: if isSignedIn()
                        && resource.data.role != 'owner'
                        && isTripOwner(tripId);
      }

      // -----------------------------------------------------------------------
      // 1.2 SOTTOCOLLEZIONE INVITE TOKENS: /trips/{tripId}/inviteTokens/{tokenId}
      // -----------------------------------------------------------------------
      match /inviteTokens/{tokenId} {
        // Solo l'owner del viaggio può visualizzare o creare/revocare token di invito per il suo viaggio.
        allow read, write: if isTripOwner(tripId) && tripId != '0000';
      }

      // -----------------------------------------------------------------------
      // 1.3 SOTTOCOLLEZIONI DATI PRIVATI DEL VIAGGIO
      // -----------------------------------------------------------------------
      match /{subcol}/{docId} {
        allow read, write: if subcol in [
                               'tappe', 'attivita', 'alloggi', 'trasporti', 'spese',
                               'documenti', 'note', 'bagagli', 'giorni', 'settings',
                               'ristoranti', 'shopping', 'locks', 'devices'
                             ]
                             && isTripMember(tripId);
      }
    }

    // =========================================================================
    // 2. TOKEN INVITO GLOBALI (per lookup O(1) lato Cloud Function)
    // =========================================================================
    match /invite_tokens/{tokenHash} {
      // Accessibile SOLO via backend / Cloud Functions con Firebase Admin SDK.
      // Nessun client può leggere o manipolare i token hashati direttamente.
      allow read, write: if false;
    }

    // Inviti legacy:
    match /invites/{inviteId} {
      // Lettura permessa per eventuale transizione se autenticati, ma nessuna scrittura client
      allow read: if isSignedIn();
      allow write: if false;
    }

    // =========================================================================
    // 3. LIVE FEEDS (PUBBLICO)
    // =========================================================================
    function validFeedHeader(data) {
      return data.keys().hasOnly(['title', 'coverPhotoUrl', 'status', 'currentCity', 'lastUpdateAt'])
             && (!('status' in data) || data.status in ['in_corso', 'completato'])
             && (!('title' in data) || (data.title is string && data.title.size() <= 120));
    }

    function validLiveUpdate(data) {
      return data.keys().hasOnly(['title', 'text', 'photoUrl', 'timestamp', 'locationName', 'reactionCounts'])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 120
             && (!('text' in data) || (data.text is string && data.text.size() <= 1000))
             && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048))
             && (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 120))
             && (!('reactionCounts' in data) || data.reactionCounts.keys().hasOnly(['❤️', '😍', '😂', '👋']));
    }

    function isGpsGuideEligible(tripId, uid) {
      return exists(/databases/$(database)/documents/trips/$(tripId))
             && (
               get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == uid
               || (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(uid))
                   && get(/databases/$(database)/documents/trips/$(tripId)/members/$(uid)).data.get('role', '') in ['owner', 'copilota'])
             );
    }

    function validGpsLease(data, tripId) {
      return data.keys().hasOnly(['holderUid', 'holderDeviceId', 'status', 'updatedAt', 'expiresAt'])
             && isGpsGuideEligible(tripId, data.holderUid)
             && data.holderDeviceId is string
             && data.holderDeviceId.size() >= 16
             && data.holderDeviceId.size() <= 128
             && data.status in ['active', 'paused', 'stopped']
             && data.updatedAt == request.time
             && data.expiresAt is timestamp
             && data.expiresAt > request.time
             && data.expiresAt <= request.time + duration.value(24, 'h');
    }

    function gpsLeaseAfter(tripId) {
      return getAfter(/databases/$(database)/documents/live_feeds/$(tripId)/gps_control/current).data;
    }

    function gpsLease(tripId) {
      return get(/databases/$(database)/documents/live_feeds/$(tripId)/gps_control/current).data;
    }

    function validGpsLocation(data) {
      return data.keys().hasOnly(['lat', 'lng', 'accuracy', 'city', 'country', 'updatedAt', 'publisherDeviceId', 'status'])
             && data.lat is number && data.lat >= -90 && data.lat <= 90
             && data.lng is number && data.lng >= -180 && data.lng <= 180
             && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000
             && data.city is string && data.city.size() <= 120
             && data.country is string && data.country.size() <= 120
             && data.publisherDeviceId is string
             && data.publisherDeviceId.size() >= 16
             && data.publisherDeviceId.size() <= 128
             && data.status in ['active', 'paused', 'stopped']
             && data.updatedAt == request.time;
    }

    match /live_feeds/{tripId} {
      // Chiunque può leggere il feed pubblico
      allow read: if true;
      allow create, update: if isTripMember(tripId) && validFeedHeader(request.resource.data);
      allow delete: if isTripOwner(tripId) && tripId != '0000';

      match /updates/{updateId} {
        allow read: if true;
        allow create, update: if isTripMember(tripId) && validLiveUpdate(request.resource.data);
        allow delete: if isTripMember(tripId) && tripId != '0000';
        
        match /reactions/{reactionId} {
          allow read: if isTripMember(tripId);
          allow create, update: if request.resource.data.type in ['❤️', '😍', '😂', '👋']
                        && request.resource.data.visitorId == reactionId
                        && request.resource.data.keys().hasOnly(['type', 'visitorId', 'timestamp']);
          allow delete: if false;
        }
      }
      match /gps_control/{controlId} {
        allow read: if controlId == 'current'
                    && isSignedIn()
                    && isGpsGuideEligible(tripId, request.auth.uid);
        allow create: if controlId == 'current'
                      && isTripOwner(tripId)
                      && validGpsLease(request.resource.data, tripId);
        allow update: if controlId == 'current'
                      && validGpsLease(request.resource.data, tripId)
                      && (
                        isTripOwner(tripId)
                        || (request.auth.uid == resource.data.holderUid
                            && request.resource.data.holderUid == resource.data.holderUid
                            && request.resource.data.holderDeviceId == resource.data.holderDeviceId
                            && request.resource.data.expiresAt == resource.data.expiresAt
                            && resource.data.status == 'active'
                            && request.resource.data.status in ['paused', 'stopped'])
                      );
        allow delete: if false;
      }

      match /locations/{locationId} {
        allow read: if locationId == 'current'
                    && (
                      (resource.data.status == 'active'
                       && resource.data.updatedAt > request.time - duration.value(2, 'm')
                       && gpsLease(tripId).status == 'active'
                       && gpsLease(tripId).expiresAt > request.time
                       && gpsLease(tripId).holderDeviceId == resource.data.publisherDeviceId)
                      || (isSignedIn() && isGpsGuideEligible(tripId, request.auth.uid))
                    );
        allow create: if locationId == 'current'
                      && isSignedIn()
                      && validGpsLocation(request.resource.data)
                      && request.resource.data.status == 'active'
                      && gpsLeaseAfter(tripId).holderUid == request.auth.uid
                      && gpsLeaseAfter(tripId).holderDeviceId == request.resource.data.publisherDeviceId
                      && gpsLeaseAfter(tripId).status == 'active'
                      && gpsLeaseAfter(tripId).expiresAt > request.time;
        allow update: if locationId == 'current'
                      && isSignedIn()
                      && validGpsLocation(request.resource.data)
                      && gpsLeaseAfter(tripId).holderDeviceId == request.resource.data.publisherDeviceId
                      && gpsLeaseAfter(tripId).expiresAt > request.time
                      && (
                        (request.resource.data.status == 'active'
                         && gpsLeaseAfter(tripId).holderUid == request.auth.uid
                         && gpsLeaseAfter(tripId).status == 'active'
                         && resource.data.updatedAt <= request.time - duration.value(15, 's'))
                        || (request.resource.data.status in ['paused', 'stopped']
                            && gpsLeaseAfter(tripId).status == request.resource.data.status
                            && (gpsLeaseAfter(tripId).holderUid == request.auth.uid || isTripOwner(tripId))
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
                      );
        allow delete: if false;
      }
    }
    // =========================================================================
    // 4. PUSH SUBSCRIBERS
    // =========================================================================
    match /push_subscribers/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && isTripMember(request.resource.data.tripId);
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.tripId == resource.data.tripId
                    && request.resource.data.deviceId == docId
                    && isTripMember(resource.data.tripId);
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // =========================================================================
    // 5. SYSTEM ADMINS (ALLOWLIST SERVER-SIDE IMMUTABILE DAI CLIENT)
    // =========================================================================
    // Nessun client può leggere o scrivere /system_admins.
    // La gestione avviene esclusivamente in ambiente fidato (Admin SDK / Console).
    match /system_admins/{adminId} {
      allow read, write: if false;
    }

    // =========================================================================
    // 6. USERS (PROFILI ED ***REMOVED*** ACCESSO UTENTE - FIREBASE SPARK)
    // =========================================================================
    // Ogni utente può aggiornare unicamente il proprio record.
    // L'Admin globale può leggere ed interrogare l'elenco utenti per la dashboard accessi.
    // L'utente ordinario può leggere unicamente il proprio profilo.
    // Nessun client può falsificare l'UID né impostare date alterate (richiesto request.time quando presente).
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isGlobalAdmin());
      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId
                            && request.resource.data.keys().hasOnly(['uid', 'displayName', 'isAnonymous', 'lastAccessAt', 'updatedAt', 'lastTripId', 'associatedTripIds'])
                            && (
                              !('lastAccessAt' in request.resource.data)
                              || request.resource.data.lastAccessAt == request.time
                            );
      allow delete: if false;
    }

  }
}
