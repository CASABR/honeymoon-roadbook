rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HOUNIGO — SECURITY RULES IN MODALITÀ LOCKDOWN TEMPORANEO (P0 MIGRAZIONE)
    // =========================================================================
    // Obiettivo:
    // 1. Zero Exposure Window: Viewer bloccati in lettura su collezioni condivise.
    // 2. Anti-Concurrency Freeze: blocco totale delle scritture client su trip '0000'
    //    per prevenire modifiche concorrenti durante la migrazione.
    // 3. Schema Guard: blocco rigido su chiavi sensibili anche per altri viaggi.
    // 4. Lo script di migrazione opera via Firebase Admin SDK (bypassando le rules).
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isTripOwner(tripId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/trips/$(tripId)) && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || get(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
        ||
        (request.resource != null && existsAfter(/databases/$(database)/documents/trips/$(tripId)) && (
          getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerUid', null) == request.auth.uid
          || getAfter(/databases/$(database)/documents/trips/$(tripId)).data.get('ownerId', null) == request.auth.uid
        ))
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') == 'owner')
      );
    }

    function isTripPrivilegedMember(tripId) {
      return isSignedIn() && (
        isTripOwner(tripId)
        ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
         && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') in ['owner', 'copilota'])
        ||
        (request.resource != null && existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid))
         && getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.get('role', '') in ['owner', 'copilota'])
      );
    }

    function isGlobalAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
        || request.auth.token.get('admin', false) == true
      );
    }

    // Schema guard: blocca qualsiasi scrittura contenente chiavi sensibili
    function hasNoSensitiveKeys(data) {
      return !data.keys().hasAny([
        'pinCode', 'codiceAccesso', 'keyboxCode',
        'bookingCode', 'pnr', 'codicePrenotazione', 'conferma', 'bookingReference',
        'ticketUrl', 'voucherUrl', 'bookingUrl', 'linkPrenotazione',
        'qrCode', 'qr', 'tavolo', 'posti', 'terminalGate',
        'cost', 'costo', 'budget', 'deposit', 'depositPaid', 'acconto', 'cauzione', 'amountPaid', 'paymentStatus',
        'noteCopilota', 'cancellazioneGratuitaEntro', 'attachments'
      ]);
    }

    match /trips/{tripId} {
      // In Lockdown: Solo Owner o Privileged Member può leggere
      allow get: if isTripPrivilegedMember(tripId) || isGlobalAdmin();
      allow list: if isGlobalAdmin();
      allow create: if isSignedIn()
                      && (request.resource.data.get('ownerUid', null) == request.auth.uid || request.resource.data.get('ownerId', null) == request.auth.uid);
      // Blocco scritture client su viaggio 0000 durante lockdown
      allow update: if isTripOwner(tripId) && tripId != '0000';
      allow delete: if false;

      // Gestione membri durante lockdown
      match /members/{uid} {
        allow read: if isTripPrivilegedMember(tripId) || isGlobalAdmin();
        allow write: if isTripOwner(tripId) && tripId != '0000';
      }

      // Cassaforte credenziali (solo Privileged, freeze su 0000 per client)
      match /private_credentials/{docId} {
        allow read: if isTripPrivilegedMember(tripId);
        allow write: if isTripPrivilegedMember(tripId) && tripId != '0000';
      }

      // Sottocollezioni documentali e contabili (solo Privileged, freeze su 0000 per client)
      match /documenti/{docId} {
        allow read: if isTripPrivilegedMember(tripId);
        allow write: if isTripPrivilegedMember(tripId) && tripId != '0000';
      }
      match /spese/{docId} {
        allow read: if isTripPrivilegedMember(tripId);
        allow write: if isTripPrivilegedMember(tripId) && tripId != '0000';
      }
      match /note/{docId} {
        allow read: if isTripPrivilegedMember(tripId);
        allow write: if isTripPrivilegedMember(tripId) && tripId != '0000';
      }

      // Sottocollezioni operative in LOCKDOWN:
      // - Lettura: RISERVATA A PRIVILEGED (Viewer bloccato durante migrazione!)
      // - Scrittura: congelata per tutti i client su viaggio 0000 (anti-concorrenza),
      //   protetta da Schema Guard per altri viaggi
      match /{subcol}/{docId} {
        allow read: if subcol in [
                         'tappe', 'attivita', 'alloggi', 'trasporti',
                         'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping',
                         'locks', 'devices'
                       ]
                       && isTripPrivilegedMember(tripId);

        allow create, update: if subcol in [
                                   'tappe', 'attivita', 'alloggi', 'trasporti',
                                   'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping',
                                   'locks', 'devices'
                                 ]
                                 && tripId != '0000'
                                 && isTripPrivilegedMember(tripId)
                                 && hasNoSensitiveKeys(request.resource.data);

        allow delete: if subcol in [
                           'tappe', 'attivita', 'alloggi', 'trasporti',
                           'bagagli', 'giorni', 'settings', 'ristoranti', 'shopping',
                           'locks', 'devices'
                         ]
                         && tripId != '0000'
                         && isTripPrivilegedMember(tripId);
      }
    }

    match /live_feeds/{tripId} {
      allow read: if true;
      allow write: if isTripPrivilegedMember(tripId) && tripId != '0000';
      match /updates/{updateId} {
        allow read: if true;
        allow write: if isTripPrivilegedMember(tripId) && tripId != '0000';
      }
    }
  }
}
