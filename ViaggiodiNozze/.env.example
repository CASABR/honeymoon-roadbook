# Credenziali Firebase del vostro progetto (Honeymoon Roadbook)
# Copiare questo file in un nuovo file nominato ".env.local" ed inserire i valori reali.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chiave sito pubblica reCAPTCHA Enterprise registrata in Firebase App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Endpoint pubblico del Worker Cloudflare HouniAI, da impostare solo dopo collaudo e deploy approvati.
VITE_HOUNIAI_WORKER_URL=https://hounigo-ai.nunzio114.workers.dev/v1/houniai

# Optional credentials for automatic test-account login during development only.
VITE_TEST_EMAIL=
VITE_TEST_PASSWORD=

# OpenRouteService / HeiGIT API Key
VITE_ORS_API_KEY=
